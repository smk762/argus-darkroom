{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "$seed",
      "steps": "$steps",
      "cfg": "$cfg",
      "sampler_name": "$sampler",
      "scheduler": "$scheduler",
      "denoise": "$denoise",
      "model": [
        "10",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "20",
        0
      ]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "$base_checkpoint"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$positive",
      "clip": [
        "11",
        0
      ]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$negative",
      "clip": [
        "11",
        0
      ]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "3",
        0
      ],
      "vae": [
        "4",
        2
      ]
    }
  },
  "9": {
    "class_type": "SaveImageWebsocket",
    "inputs": {
      "images": [
        "21",
        0
      ]
    }
  },
  "10": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "$lora",
      "strength_model": "$lora_weight",
      "strength_clip": "$lora_weight",
      "model": [
        "4",
        0
      ],
      "clip": [
        "4",
        1
      ]
    }
  },
  "11": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "stop_at_clip_layer": "$clip_skip",
      "clip": [
        "10",
        1
      ]
    }
  },
  "12": {
    "class_type": "DarkroomLoadImageBase64",
    "inputs": {
      "image": "$init_image"
    }
  },
  "13": {
    "class_type": "ImageScale",
    "inputs": {
      "upscale_method": "lanczos",
      "width": "$width",
      "height": "$height",
      "crop": "center",
      "image": [
        "12",
        0
      ]
    }
  },
  "14": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "13",
        0
      ],
      "vae": [
        "4",
        2
      ]
    }
  },
  "15": {
    "class_type": "DarkroomLoadMaskBase64",
    "inputs": {
      "mask": "$init_mask"
    }
  },
  "16": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "15",
        0
      ]
    }
  },
  "17": {
    "class_type": "ImageScale",
    "inputs": {
      "upscale_method": "nearest-exact",
      "width": "$width",
      "height": "$height",
      "crop": "center",
      "image": [
        "16",
        0
      ]
    }
  },
  "18": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "17",
        0
      ],
      "channel": "red"
    }
  },
  "19": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "18",
        0
      ],
      "expand": 8,
      "tapered_corners": true
    }
  },
  "20": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": [
        "14",
        0
      ],
      "mask": [
        "19",
        0
      ]
    }
  },
  "21": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "13",
        0
      ],
      "source": [
        "8",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "19",
        0
      ]
    }
  }
}
