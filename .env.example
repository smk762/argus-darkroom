# Copy to .env. Compose reads it; nothing here is a secret, but .env is git-ignored all the same.

# --- Required ---------------------------------------------------------------
# SingGuard (agent-composer's /api/guard/check). Darkroom never runs unguarded: without this it refuses to start.
SINGGUARD_URL=http://host.docker.internal:9150
# ComfyUI models root (the folder that holds checkpoints/ and loras/). Mounted read-only; hashed for the record.
# Use the directory ComfyUI actually lists — if it loads models via extra_model_paths.yaml, that folder, not models/.
MODELS_ROOT=/path/to/ComfyUI/models
# The checkpoint a form starts on: an exact name, or a folder under checkpoints/ for the first model in it.
DEFAULT_CHECKPOINT=sdxl

# --- Backends, reached by URL (they run outside compose) ---------------------
COMFYUI_URL=http://host.docker.internal:8188
# NudeNet. Empty means SFW generation is unavailable (every SFW output would be omitted), so darkroom refuses it.
NUDENET_URL=
# Curator's POST /faces?body=true (InsightFace + MiVOLO, body crop and unmatched people). Empty falls back to the in-process [age] extra.
AGE_URL=http://host.docker.internal:8101
# How the minor-exposed rule places exposure: frame (any age estimate under 18 plus exposure anywhere) | overlap
# (exposure on a young person's box, or on no box). Anything else refuses to start.
MINOR_EXPOSED=frame
# Prompt expansion. Both must be set to turn it on.
OLLAMA_URL=
OLLAMA_MODEL=

# --- Policy ------------------------------------------------------------------
# 1 lets an NSFW policy enforce (and makes adult-granular the default). Anything else: SFW only.
ALLOW_NSFW=0
# cascade | fast | fast-slow | slow
THINKING=cascade
# 1 refuses every write: generation, pre-flight and record changes. Records stay readable.
READ_ONLY=0
# Origin(s) of the UI allowed to write, comma separated. Safelight's address as the browser sees it.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Development -------------------------------------------------------------
# 1 adds POST /purge and the purge button in safelight: it deletes every record and image. Leave off elsewhere.
DEVMODE=0

# --- Publish -------------------------------------------------------------------
# Host:port published for each service. 127.0.0.1 keeps them off the LAN.
# Use 0.0.0.0:<port> only when the UI is opened as a LAN address (the browser then
# calls that same host). Darkroom is not for public hosting.
DARKROOM_PUBLISH=127.0.0.1:8106
SAFELIGHT_PUBLISH=127.0.0.1:3000

# --- Safelight -----------------------------------------------------------------
# Where the browser reaches darkroom. Baked into the safelight image when it is built.
DARKROOM_PUBLIC_URL=http://localhost:8106
# Safelight's repo, as a build context, until it publishes an image.
SAFELIGHT_CONTEXT=../argus-safelight

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
