# Copy to .env. Compose reads it; nothing here is a secret, but .env is git-ignored all the same.

# --- Required ---------------------------------------------------------------
# SingGuard (agent-composer's /api/guard/check). Darkroom never runs unguarded: without a SingGuard URL it refuses to
# start. Empty here, the suite-wide ARGUS_SINGGUARD_URL is used (see "Shared settings" below).
SINGGUARD_URL=http://host.docker.internal:9150
# ComfyUI models root (the folder that holds checkpoints/ and loras/). Mounted read-only; hashed for the record.
# Use the directory ComfyUI actually lists — if it loads models via extra_model_paths.yaml, that folder, not models/.
MODELS_ROOT=/path/to/ComfyUI/models
# The checkpoint a form starts on: an exact name, or a folder under checkpoints/ for the first model in it.
DEFAULT_CHECKPOINT=sdxl

# --- Backends, reached by URL (they run outside compose) ---------------------
# Each is this repo's name for a suite-wide one: COMFYUI_URL then ARGUS_COMFYUI_URL, NUDENET_URL then
# ARGUS_NUDENET_URL, OLLAMA_URL then ARGUS_OLLAMA_URL (here, in the shell, or in the suite file). Empty falls through
# to the suite-wide name; `off` keeps a backend unconfigured whatever the suite says. A value that is not an
# absolute http(s) URL stops darkroom starting: a typo never turns a check off.
COMFYUI_URL=http://host.docker.internal:8188
# NudeNet. Empty means SFW generation is unavailable (every SFW output would be omitted), so darkroom refuses it.
# Point it at the suite's shared 640m server (argus-cortex#79) once it is up. Each record names the detector that
# scored it (guard.nudenet.detector), since 640m and 320n score the same image differently.
NUDENET_URL=
# Curator's POST /faces?body=true (InsightFace + MiVOLO, body crop and unmatched people). Empty falls back to the
# in-process [age] extra and, where that cannot run (the image has none), to ARGUS_CURATOR_URL in the suite file.
AGE_URL=http://host.docker.internal:8101
# How the minor-exposed rule places exposure: frame (any age estimate under 18 plus exposure anywhere) | overlap
# (exposure on a young person's box, or on no box). Anything else refuses to start.
MINOR_EXPOSED=frame
# Prompt expansion. Both must be set to turn it on.
OLLAMA_URL=
OLLAMA_MODEL=

# --- Policy ------------------------------------------------------------------
# 1 lets an NSFW policy enforce (and makes adult-granular the default). Anything else: SFW only.
ALLOW_NSFW=0
# cascade | fast | fast-slow | slow
THINKING=cascade
# 1 refuses every write: generation, pre-flight and record changes. Records stay readable.
READ_ONLY=0
# Origin(s) of the UI allowed to write, comma separated. Safelight's address as the browser sees it.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- GPU leases (argus-iris) -------------------------------------------------
# Set ARGUS_GPU_BROKER_URL and argus-iris (the suite's GPU broker) grants a lease for each render and each prompt
# expansion, queues them by priority and may send the work to another node's ComfyUI or Ollama. A second generation
# then waits in iris's queue instead of getting a 409. Darkroom registers its gpu-tenant.yaml (shipped in the image at
# /app/gpu-tenant.yaml) at startup. Empty is no gating.
# Where iris listens, by IP, e.g. http://<GPU_BROKER_HOST>:8120: the container does not resolve LAN host names
# (argus-iris's deploy/iris.yaml uses IPs for the same reason).
ARGUS_GPU_BROKER_URL=
# The suite's shared caller token (Authorization: Bearer). A secret: put the real value in .env only, never here.
ARGUS_GPU_BROKER_TOKEN=
# How long a generation waits for its lease before it fails (seconds; cortex's default is 300).
ARGUS_GPU_LEASE_TIMEOUT_S=

# --- Shared settings (the suite file) ----------------------------------------
# Values every Argus service on this host shares (ARGUS_GPU_BROKER_URL, ARGUS_GPU_BROKER_TOKEN, ARGUS_SINGGUARD_URL,
# ARGUS_NUDENET_URL, ARGUS_COMFYUI_URL, ARGUS_OLLAMA_URL, ARGUS_CURATOR_URL) can be written once in the suite file,
# ~/.config/argus/suite.env (mode 600; create it with `python -m argus_cortex.settings --init`), instead of in each
# repo's .env. Anything set here still wins. Compose mounts it only when asked (read compose.suite.yaml first: the
# mounted file must be owned by root today):
#COMPOSE_FILE=compose.yaml:compose.suite.yaml
# Another location for the file on the host:
#ARGUS_SUITE_ENV=<CONFIG_DIR>/suite.env

# --- Development -------------------------------------------------------------
# 1 adds POST /purge and the purge button in safelight: it deletes every record and image. Leave off elsewhere.
DEVMODE=0

# --- Publish -------------------------------------------------------------------
# Host:port published for each service. 127.0.0.1 keeps them off the LAN.
# Use 0.0.0.0:<port> only when the UI is opened as a LAN address (the browser then
# calls that same host). Darkroom is not for public hosting.
DARKROOM_PUBLISH=127.0.0.1:8106
SAFELIGHT_PUBLISH=127.0.0.1:3000

# --- Safelight -----------------------------------------------------------------
# Where the browser reaches darkroom. Baked into the safelight image when it is built.
DARKROOM_PUBLIC_URL=http://localhost:8106
# Safelight's repo, as a build context, until it publishes an image.
SAFELIGHT_CONTEXT=../argus-safelight

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
