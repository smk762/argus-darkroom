{
  "$defs": {
    "AgeRecord": {
      "properties": {
        "faces": {
          "items": {
            "$ref": "#/$defs/FaceAge"
          },
          "title": "Faces",
          "type": "array"
        },
        "minor_exposed": {
          "default": false,
          "title": "Minor Exposed",
          "type": "boolean"
        },
        "minor_exposed_rule": {
          "default": "frame",
          "enum": [
            "frame",
            "overlap"
          ],
          "title": "Minor Exposed Rule",
          "type": "string"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/PersonAge"
          },
          "title": "People",
          "type": "array"
        },
        "source": {
          "const": "mivolo",
          "default": "mivolo",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "AgeRecord",
      "type": "object"
    },
    "Cell": {
      "description": "One policy's verdict in one context: a state, and the SingGuard answer or the error behind it.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "safe",
            "flagged",
            "illegal",
            "unchecked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "Cell",
      "type": "object"
    },
    "ControlImageRef": {
      "description": "The identity of the skeleton drawing ComfyUI got: the PNG's sha256 (re-encoded with no metadata) and size.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "width",
        "height"
      ],
      "title": "ControlImageRef",
      "type": "object"
    },
    "DepthRecord": {
      "description": "A depth map derived from the record's stored image (``POST /depth/{id}``), never from a new prompt.\n\nThe PNG is 8-bit greyscale at the image's size, near bright (255) and far dark (0), stretched min to max per image,\nwith no metadata. ``sha256`` is of the stored PNG's bytes. ``workflow`` names darkroom's built-in depth graph.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Version"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_license": {
          "title": "Model License",
          "type": "string"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "workflow": {
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "model",
        "model_license",
        "sha256",
        "width",
        "height",
        "workflow"
      ],
      "title": "DepthRecord",
      "type": "object"
    },
    "Expansion": {
      "description": "How Ollama expanded the prompt: enough to know which system prompt was used.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "system_prompt_sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "model",
        "system_prompt_sha256"
      ],
      "title": "Expansion",
      "type": "object"
    },
    "FaceAge": {
      "description": "A MiVOLO age estimate for one detected face. A tool's estimate, never a stated age.",
      "properties": {
        "age_estimate_years": {
          "title": "Age Estimate Years",
          "type": "number"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "age_estimate_years",
        "bbox"
      ],
      "title": "FaceAge",
      "type": "object"
    },
    "GenerationRecord": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "darkroom_version": {
          "title": "Darkroom Version",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guard": {
          "$ref": "#/$defs/GuardRecord"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "enum": [
            "refused",
            "passed",
            "review",
            "deleted",
            "omitted",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "outcome_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Reason"
        },
        "pose_adherence": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseAdherenceRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "record_version": {
          "default": "1.0",
          "title": "Record Version",
          "type": "string"
        },
        "removed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removed At"
        },
        "request": {
          "$ref": "#/$defs/RequestRecord"
        }
      },
      "required": [
        "id",
        "darkroom_version",
        "outcome",
        "request",
        "guard"
      ],
      "title": "GenerationRecord",
      "type": "object"
    },
    "GuardRecord": {
      "properties": {
        "advisory_policies": {
          "items": {
            "type": "string"
          },
          "title": "Advisory Policies",
          "type": "array"
        },
        "age": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgeRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enforcing_policy": {
          "title": "Enforcing Policy",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputScanRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nudenet": {
          "anyOf": [
            {
              "$ref": "#/$defs/NudeNetRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pose_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputScanRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preflight": {
          "additionalProperties": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Preflight",
          "type": "object"
        },
        "scans": {
          "additionalProperties": {
            "$ref": "#/$defs/ScanCells"
          },
          "title": "Scans",
          "type": "object"
        },
        "thinking": {
          "title": "Thinking",
          "type": "string"
        }
      },
      "required": [
        "enforcing_policy",
        "thinking"
      ],
      "title": "GuardRecord",
      "type": "object"
    },
    "GuardResult": {
      "description": "SingGuard's verdict on one image. A verdict, not a score: SingGuard\nreports which policy rules fired, not how confident it is.",
      "properties": {
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "policy": {
          "default": "default",
          "title": "Policy",
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        }
      },
      "required": [
        "safe"
      ],
      "title": "GuardResult",
      "type": "object"
    },
    "ImageRecord": {
      "description": "The identity of the output. The hashes are kept even when the pixels are not.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "phash": {
          "title": "Phash",
          "type": "string"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "phash",
        "width",
        "height"
      ],
      "title": "ImageRecord",
      "type": "object"
    },
    "InitImageRef": {
      "description": "The identity of an image-to-image input, never its pixels: the caller keeps its own input.\n\nThe hashes and size are of the image as darkroom judged it and sent it to ComfyUI: decoded, turned upright, made\nRGB and re-encoded as a PNG with no metadata. ``source_sha256`` is of the bytes the caller sent.",
      "properties": {
        "denoise": {
          "title": "Denoise",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phash": {
          "title": "Phash",
          "type": "string"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "phash",
        "width",
        "height",
        "source_sha256",
        "denoise"
      ],
      "title": "InitImageRef",
      "type": "object"
    },
    "InputScanRecord": {
      "description": "An input image's own scan (the image-to-image input, or a pose photo): the same checks an output gets, before\nanything reaches ComfyUI or argus-puppet.\n\nThe input goes on only when ``outcome`` is ``passed``; anything else refuses the attempt. ``outcome`` and\n``reason`` are what the outcome table said of the input, as if it were an output.",
      "properties": {
        "age": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgeRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nudenet": {
          "$ref": "#/$defs/NudeNetRecord"
        },
        "outcome": {
          "enum": [
            "refused",
            "passed",
            "review",
            "deleted",
            "omitted",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scans": {
          "additionalProperties": {
            "$ref": "#/$defs/ScanCells"
          },
          "title": "Scans",
          "type": "object"
        }
      },
      "required": [
        "nudenet",
        "outcome"
      ],
      "title": "InputScanRecord",
      "type": "object"
    },
    "LoRARef": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "trigger_words": {
          "items": {
            "type": "string"
          },
          "title": "Trigger Words",
          "type": "array"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "title": "LoRARef",
      "type": "object"
    },
    "MaskRef": {
      "description": "The identity of an inpainting mask, never its pixels. The mask selects the region of the input that is\nrepainted; it carries no imagery, so it is not scanned.\n\n``sha256`` is of the mask as ComfyUI got it: turned upright, cut into black and white at 128 and re-encoded as a\n1-bit PNG with no metadata. ``source_sha256`` is of the bytes the caller sent.",
      "properties": {
        "masked_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Masked Fraction",
          "type": "number"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "source_sha256",
        "masked_fraction"
      ],
      "title": "MaskRef",
      "type": "object"
    },
    "ModelRef": {
      "description": "A model file pinned by content: the name the engine loads and its sha256.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "description": "lowercase hex SHA256 digest",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "NudeNetBox": {
      "description": "One NudeNet detection: a class, its score and where it is. A box, never pixels.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score",
        "bbox"
      ],
      "title": "NudeNetBox",
      "type": "object"
    },
    "NudeNetRecord": {
      "description": "What NudeNet said, kept for every rendered image. *exposed_score* is null when it did not answer (or is not\nconfigured), and the labels are then empty: under an NSFW policy that blurs the image, under SFW it omits it.",
      "properties": {
        "blur": {
          "title": "Blur",
          "type": "boolean"
        },
        "detections": {
          "items": {
            "$ref": "#/$defs/NudeNetBox"
          },
          "title": "Detections",
          "type": "array"
        },
        "detector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector"
        },
        "detector_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector Model"
        },
        "exposed_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exposed Score"
        },
        "labels": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Labels",
          "type": "object"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "exposed_score",
        "threshold",
        "blur"
      ],
      "title": "NudeNetRecord",
      "type": "object"
    },
    "PersonAge": {
      "description": "One person (body) box from curator's person detector, with its MiVOLO estimate when it has one.\n\n``face_index`` is the face in :attr:`AgeRecord.faces` this person was matched to, or ``None`` for a body with\nno face. A matched person's estimate may be ``None``: the face carries it. An unmatched person's estimate is\nalso in :attr:`AgeRecord.faces`, so ``faces`` alone still holds every estimate.",
      "properties": {
        "age_estimate_years": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Estimate Years"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "face_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Index"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "PersonAge",
      "type": "object"
    },
    "PoseAdherenceMatch": {
      "description": "One drawn person and the person in the output holding their pose, if any (argus-puppet's ``AdherenceMatch``).",
      "properties": {
        "close": {
          "default": false,
          "title": "Close",
          "type": "boolean"
        },
        "distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance"
        },
        "mirrored": {
          "default": false,
          "title": "Mirrored",
          "type": "boolean"
        },
        "mirrored_distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mirrored Distance"
        },
        "output": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "target": {
          "minimum": 0,
          "title": "Target",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "title": "PoseAdherenceMatch",
      "type": "object"
    },
    "PoseAdherenceRecord": {
      "description": "Whether the released image holds the pose it was asked for, as argus-puppet's ``POST /adherence`` judged it.\n\nA measurement, never a verdict: it changes no outcome and is made only for an image that was already released\n(passed or review). It compares pose shape (the 17 body joints, hip-centred and torso-scaled), not where a figure\nstands in the frame, its size, hands or face. ``adheres`` is null, with ``error`` saying why, when the check\ncould not run; the image is released either way.",
      "properties": {
        "adheres": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adheres"
        },
        "close": {
          "default": 0,
          "title": "Close",
          "type": "integer"
        },
        "comparable": {
          "default": 0,
          "title": "Comparable",
          "type": "integer"
        },
        "distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "estimator": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseEstimatorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "matched": {
          "default": 0,
          "title": "Matched",
          "type": "integer"
        },
        "matches": {
          "items": {
